{
    "cpu": {
        "format": "<span color='#f7768e'>\uf4bc</span> {usage}%",
        "interval": 2,
        "tooltip": true
    },
    "memory": {
        "format": "<span color='#7aa2f7'>\uf538</span> {percentage}%",
        "tooltip-format": "{used:0.1f} GiB usados de {total:0.1f} GiB",
        "interval": 2
    },
    "custom/gpu": {
        "format": "<span color='#73daca'>\udb82\udcae</span> {}%",
        "exec": "~/.config/waybar/scripts/gpu-json.sh",
        "interval": 2,
        "return-type": "json",
        "tooltip": true
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "format": "<span color='#e0af68'>\uf2c9</span> {temperatureC}°C",
        "critical-threshold": 80,
        "interval": 2,
        "tooltip": false
    },
    "custom/expand": {
        "format": "\uf104",
        "tooltip": false
    },
    "group/sys": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": ["custom/expand", "cpu", "memory", "custom/gpu", "temperature"]
    },
    "cava": {
        "framerate": 30,
        "bars": 14,
        "bar_delimiter": 0,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "method": "pipewire",
        "source": "auto",
        "hide_on_silence": true,
        "sleep_timer": 5,
        "tooltip": false
    },
    "mpris": {
        "player": "spotify",
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " - ",
        "player-icons": { "default": "\uf1bc" },
        "status-icons": { "paused": "\uf04c" },
        "max-length": 40,
        "on-click": "playerctl -p spotify play-pause",
        "on-click-right": "playerctl -p spotify next",
        "on-scroll-up": "playerctl -p spotify previous",
        "on-scroll-down": "playerctl -p spotify next",
        "tooltip": false
    }
}
